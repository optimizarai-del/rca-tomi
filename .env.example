# ════════════════════════════════════════════════════════════════════
# RCA — Variables de entorno para deploy con docker compose / Easy Panel
# ════════════════════════════════════════════════════════════════════
#
# 1) Copiá este archivo a .env y completá los valores.
# 2) Para Easy Panel: pegá estos pares en la sección "Environment" del
#    servicio Compose.
# 3) Variables marcadas con (!) son OBLIGATORIAS para arrancar.

# ─── Postgres (DB interna del compose) ──────────────────────────────
POSTGRES_USER=rca
POSTGRES_PASSWORD=cambiame-por-algo-largo
POSTGRES_DB=rca

# Si dejás esto comentado, el backend se arma solo con los valores de arriba.
# Si usás una DB managed (Supabase, Neon, RDS), seteá la URL completa acá:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+psycopg://rca:cambiame-por-algo-largo@db:5432/rca

# ─── Auth (!) ───────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-string-largo-random-de-al-menos-48-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ──────────────────────────────────────────────────────────
# Como el frontend hace proxy_pass al backend, las llamadas son same-origin.
# Si vas a llamar al backend desde otra app (mobile, otro dominio), listalos:
CORS_ORIGINS=*

# ─── Frontend ──────────────────────────────────────────────────────
# Puerto en el host donde se publica el frontend. Easy Panel suele
# manejar 80/443 con su reverse proxy → dejá 8080 acá.
FRONTEND_PORT=8080

# URL absoluta del backend para el frontend. VACÍO = mismo dominio (recomendado
# porque el nginx del frontend hace proxy_pass al backend internamente).
VITE_API_URL=

# ─── Agente Operario IA (!) ────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-poner-tu-key-aqui
AGENT_MODEL=claude-sonnet-4-5

# ─── WhatsApp (opcional, Sprint 4) ─────────────────────────────────
# log_only = no envía, solo registra. twilio o cloud_api para producción.
WHATSAPP_PROVIDER=log_only
WHATSAPP_WEBHOOK_TOKEN=cambia-este-token-secreto

# Solo si WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886

# Solo si WHATSAPP_PROVIDER=cloud_api
# CLOUD_API_PHONE_ID=123456789012345
# CLOUD_API_TOKEN=EAAxxxxxxxxxxxxxxxx

# ─── Telegram bot (opcional, Sprint 11) ────────────────────────────
# Crear bot con @BotFather → /newbot → copiá el token acá.
# Si está vacío, el bot queda desactivado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ─── Sentry (opcional, Sprint 8) ───────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1
