# ════════════════════════════════════════════════════════════════════
# RCA — Variables de entorno para deploy con docker compose / Easy Panel
# ════════════════════════════════════════════════════════════════════
#
# 1) Copiá este archivo a .env y completá los valores.
# 2) Para Easy Panel: pegá estos pares en la sección "Environment" del
#    servicio Compose.
# 3) Variables marcadas con (!) son OBLIGATORIAS para arrancar.

# ─── DB — Supabase Postgres managed (!) ────────────────────────────
# Usar Session pooler (puerto 5432 en *.pooler.supabase.com), NO Transaction
# pooler (6543). Transaction pooler rompe Alembic y prepared statements.
#
# Cómo conseguirla:
#   Supabase Dashboard → Settings → Database → Connection string → URI
#   → tab "Session pooler"
#   → reemplazar [YOUR-PASSWORD] con tu pass del proyecto
#   → cambiar "postgresql://" por "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://postgres.PROJREF:TU_PASS@aws-X-region.pooler.supabase.com:5432/postgres

# ─── Auth (!) ───────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-string-largo-random-de-al-menos-48-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ─── Frontend ──────────────────────────────────────────────────────
# VITE_API_URL vacío = same-origin (nginx proxea /api → backend)
VITE_API_URL=

# ─── Agente Operario IA (!) ────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-poner-tu-key-aqui
AGENT_MODEL=claude-sonnet-4-5

# ─── WhatsApp (opcional, Sprint 4) ─────────────────────────────────
WHATSAPP_PROVIDER=log_only
WHATSAPP_WEBHOOK_TOKEN=cambia-este-token-secreto

# Solo si WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886

# Solo si WHATSAPP_PROVIDER=cloud_api
# CLOUD_API_PHONE_ID=123456789012345
# CLOUD_API_TOKEN=EAAxxxxxxxxxxxxxxxx

# ─── Telegram bot (opcional, Sprint 11) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ─── Sentry (opcional, Sprint 8) ───────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1
