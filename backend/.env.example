# ─── Base de datos ───
# Default: SQLite local (sin Docker). Cambiar a Postgres con docker-compose:
#   docker compose up -d
#   DATABASE_URL=postgresql+psycopg://rca:rca_dev@localhost:5433/rca
DATABASE_URL=sqlite:///./fielddata.db

# ─── Auth ───
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ───
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:5174

# ─── Webhook WhatsApp (opcional) ───
WHATSAPP_WEBHOOK_TOKEN=set-shared-token-with-n8n

# ─── Agente Operario IA (REQUERIDO para el chat) ───
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-tu-key-aqui
AGENT_MODEL=claude-sonnet-4-5

# ─── Server ───
# PORT=8010
# RELOAD=1
