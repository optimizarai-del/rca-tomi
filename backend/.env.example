# ─── Base de datos ───
# Default: SQLite local (sin Docker). Cambiar a Postgres con docker-compose:
#   docker compose up -d
#   DATABASE_URL=postgresql+psycopg://rca:rca_dev@localhost:5433/rca
DATABASE_URL=sqlite:///./fielddata.db

# ─── Auth ───
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ───
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:5174

# ─── WhatsApp inbound + outbound (Sprint 4) ───
# Token compartido con el provider que llama al webhook /api/whatsapp/inbound
WHATSAPP_WEBHOOK_TOKEN=set-shared-token-with-n8n

# Provider para mensajes salientes:
#   log_only   → registra en DB pero NO envía (default, ideal para dev/test)
#   twilio     → llama a Twilio WhatsApp API
#   cloud_api  → llama a Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=log_only

# Twilio (solo si WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886

# Meta Cloud API (solo si WHATSAPP_PROVIDER=cloud_api)
# CLOUD_API_PHONE_ID=123456789012345
# CLOUD_API_TOKEN=EAAxxxxxxxxxxxxxxxx

# ─── Agente Operario IA (REQUERIDO para el chat) ───
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-tu-key-aqui
AGENT_MODEL=claude-sonnet-4-5

# ─── Server ───
# PORT=8010
# RELOAD=1
