ANTHROPIC_API_KEY=sk-ant-api03-tu-key-aqui
AGENT_MODEL=claude-sonnet-4-5

# Backend port (default 8010)
# PORT=8010
# Hot-reload de uvicorn (1=on). Off por default por bug en OneDrive/Windows.
# RELOAD=1
